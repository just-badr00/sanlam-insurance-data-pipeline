# Publish only selected deliverables. Everything else stays local.
/*
!/.gitignore
!/.gitattributes
!/.dockerignore
!/.env.example
!/README.md
!/requirements.txt
!/dashboard.twb
!/src/
!/notebooks/
!/airflow/
!/sql/
!/docs/
!/output/
!/assets/
/assets/*
!/assets/airflow-dag.png
!/assets/claims-dashboard.png
/src/*
!/src/*.py
/notebooks/*
!/notebooks/*.ipynb
/airflow/*
!/airflow/Dockerfile
!/airflow/docker-compose.yaml
!/airflow/requirements-sanlam.txt
!/airflow/dags/
/airflow/dags/*
!/airflow/dags/sanlam_insurance_pipeline.py
/sql/*
!/sql/SANLAM.sql
/docs/*
!/docs/PROJECT_CONTRACT.md
/output/*
!/output/pdf/
/output/pdf/*
!/output/pdf/sanlam_project_report_25_26.pdf

# Defense in depth for allowed directories.
**/.env
**/.env.*
!/.env.example
**/__pycache__/
**/*.py[cod]
**/.ipynb_checkpoints/
**/*.log
**/*.pem
**/*.key
**/~*
